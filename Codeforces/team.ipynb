    "n=int(input(\"n:\"))\n",
    "s=0\n",
    "for _ in range(n):\n",
    "    a,b,c=map(int,input().split())\n",
    "    \n",
    "    if a+b+c>=2:\n",
    "        s+=1\n",
    "\n",
    "\n",
    "print(s)"
   ]
