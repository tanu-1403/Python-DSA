    "#way too long words\n",
    "n = int(input())\n",
    "\n",
    "for _ in range(n):\n",
    "    word = input().strip()\n",
    "    if len(word) > 10:\n",
    "        print(word[0] + str(len(word) - 2) + word[-1])\n",
    "    else:\n",
    "        print(word)\n",
    "        \n",
    "#n was supposed to be number of inputs"
